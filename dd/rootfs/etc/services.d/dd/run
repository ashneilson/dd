#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the dd service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
bashio::log.info "Starting dd..."

# Retrieve global config/service values
DEBUG=$(bashio::config 'debug')

if bashio::config.exists 'poll_interval'; then
    POLL_INTERVAL="$(bashio::config 'poll_interval')"
else
    POLL_INTERVAL="60"
fi
POLL_INTERVAL_FLAG="-pollInterval ${POLL_INTERVAL}s"

# Build the hub configuration file consumed by the haus binary. Read the 'hubs' list
# directly from the add-on options file: its objects' keys (name, host, code, password,
# mqtt_prefix) already match the JSON the haus binary expects. Reading the file directly
# with jq avoids ambiguity in how bashio::config returns complex (list) values.
HUBS_FILE="/tmp/dd-hubs.json"
OPTIONS_FILE="/data/options.json"

HUB_COUNT="$(jq '(.hubs // []) | length' "${OPTIONS_FILE}" 2>/dev/null || echo 0)"
if [ -z "${HUB_COUNT}" ] || [ "${HUB_COUNT}" -eq 0 ]; then
    bashio::log.fatal "No hubs configured. Add at least one hub (host, mqtt_prefix and, for first-time registration, a share code and password) in the add-on configuration."
    # Diagnostic (no secrets): show which option keys the supervisor actually saved.
    bashio::log.info "Option keys present: $(jq -rc 'keys' "${OPTIONS_FILE}" 2>/dev/null)"
    exit 1
fi

# Wrap as {"hubs": [...]} for the haus binary. The file may contain hub share codes and
# passwords, so create it readable only by the add-on (umask 077 -> 0600) and fail fast
# (without leaving a half-written file) if jq cannot write it.
if ! ( umask 077 && jq '{hubs: (.hubs // [])}' "${OPTIONS_FILE}" > "${HUBS_FILE}" ); then
    rm -f "${HUBS_FILE}"
    bashio::log.fatal "Could not write the hub configuration file."
    exit 1
fi

HUB_PREFIXES="$(jq -r '[(.hubs // [])[].mqtt_prefix] | join(", ")' "${OPTIONS_FILE}")"
bashio::log.info "Configured ${HUB_COUNT} hub(s): ${HUB_PREFIXES}"

# Check if user provided custom MQTT settings or use HA MQTT service
if bashio::config.exists 'mqtt.broker'; then
    bashio::log.info "Using custom MQTT broker configuration."
    MQTT_HOST="$(bashio::config 'mqtt.broker')"
    MQTT_PORT="$(bashio::config 'mqtt.port')"
    MQTT_USER="$(bashio::config 'mqtt.username')"
    MQTT_PASSWORD="$(bashio::config 'mqtt.password')"
else
    bashio::log.info "Using Home Assistant MQTT service."

    # Fetch MQTT connection details directly from the Supervisor API (GET /services/mqtt),
    # with a short retry. We deliberately do NOT use bashio::services.available /
    # bashio::services here: some Supervisor / HA OS versions cause bashio to spuriously
    # report the MQTT service as "not enabled" even when a broker is configured (a known
    # bashio discovery issue). Querying the API ourselves avoids that.
    SUP_TOKEN="${SUPERVISOR_TOKEN:-${HASSIO_TOKEN:-}}"
    MQTT_HOST=""
    MQTT_LAST_RESPONSE=""
    tries=0
    while [ "${tries}" -lt 30 ]; do
        MQTT_LAST_RESPONSE="$(curl -s -H "Authorization: Bearer ${SUP_TOKEN}" "http://supervisor/services/mqtt" 2>/dev/null)"
        if [ "$(printf '%s' "${MQTT_LAST_RESPONSE}" | jq -r '.result // empty' 2>/dev/null)" = "ok" ]; then
            MQTT_HOST="$(printf '%s' "${MQTT_LAST_RESPONSE}" | jq -r '.data.host // empty')"
            MQTT_PORT="$(printf '%s' "${MQTT_LAST_RESPONSE}" | jq -r '.data.port // empty')"
            MQTT_USER="$(printf '%s' "${MQTT_LAST_RESPONSE}" | jq -r '.data.username // empty')"
            MQTT_PASSWORD="$(printf '%s' "${MQTT_LAST_RESPONSE}" | jq -r '.data.password // empty')"
            if [ -n "${MQTT_HOST}" ]; then
                break
            fi
        fi
        if [ "${tries}" -eq 0 ]; then
            bashio::log.warning "Home Assistant MQTT service not available yet; waiting..."
        fi
        tries=$((tries + 1))
        sleep 2
    done

    if [ -z "${MQTT_HOST}" ]; then
        bashio::log.fatal "Could not obtain MQTT details from Home Assistant. Supervisor reported: $(printf '%s' "${MQTT_LAST_RESPONSE}" | jq -rc '.message // .result // "no response"' 2>/dev/null)."
        bashio::log.fatal "Install and START an MQTT broker add-on (e.g. Mosquitto), or set a custom MQTT broker (mqtt.broker/port/username/password) in this add-on's configuration."
        exit 1
    fi

    bashio::log.info "Using Home Assistant MQTT service at ${MQTT_HOST}:${MQTT_PORT}."
fi

# Conditionally set the debug flag
if [ "${DEBUG}" = "true" ]; then
    DEBUG_FLAG="-debug"
    bashio::log.info "Debug mode is enabled."
else
    DEBUG_FLAG=""
fi

# Run the dd/haus command in multi-hub mode. Per-hub credentials are stored under /config
# keyed by each hub's base station ID, and registration happens automatically on first run
# for any hub that has a share code but no stored credentials yet.
exec /usr/bin/dd/haus \
    -hubs "${HUBS_FILE}" \
    -credentialsDir /config \
    -mqtt "${MQTT_HOST}" \
    -mqttPort "${MQTT_PORT}" \
    -mqttUser "${MQTT_USER}" \
    -mqttPassword "${MQTT_PASSWORD}" \
    ${POLL_INTERVAL_FLAG} \
    ${DEBUG_FLAG}
